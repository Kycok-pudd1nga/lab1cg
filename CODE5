const unsigned int SCR_WIDTH = 1024;
const unsigned int SCR_HEIGHT = 768;

float   lastX = SCR_WIDTH / 2.0f,
lastY = SCR_HEIGHT / 2.0f;

bool firstMouse = true;
float yaw = -90.0f;
float pitch = 0.0f;
float fov = 45.0f;

float deltaTime = 0.0f;
float lastFrame = 0.0f;

glm::mat4 OX1_POS(1.0);
glm::mat4 OX2_POS(1.0);
glm::mat4 OX3_POS(1.0);

float OX1_Angle;
float OX2_Angle;
float OX3_Angle;

int main() {
    if (!glfwInit()) {
        std::cerr << "ERROR glfwInit" << std::endl;
        return -1;
    }

    glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 4);
    glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 6);
    glfwWindowHint(GLFW_OPENGL_FORWARD_COMPAT, GL_TRUE);
    glfwWindowHint(GLFW_OPENGL_PROFILE, GLFW_OPENGL_CORE_PROFILE);

    GLFWwindow* window = glfwCreateWindow(512, 512, "WINWIN", NULL, NULL);
    if (!window) {
        glfwTerminate();
        return -2;
    }

    glfwMakeContextCurrent(window);
    glewExperimental = GL_TRUE;
    if (glewInit() != GLEW_OK) {
        std::cerr << "ERROR glewInit" << std::endl;
        return -3;
    }

    Model ourRTC("lab3d.obj");   

    GLuint vbo, vao;
    glGenBuffers(1, &vbo);
    glGenVertexArrays(1, &vao);
    glBindVertexArray(vao);
    glBindBuffer(GL_ARRAY_BUFFER, vbo);
    glBufferData(GL_ARRAY_BUFFER, sizeof(vertices), vertices, GL_STATIC_DRAW);
    glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, 3 * sizeof(float), (void*)0);
    glEnableVertexAttribArray(0);
    glBindBuffer(GL_ARRAY_BUFFER, 0);
    glBindVertexArray(0);

    glfwSetFramebufferSizeCallback(window, framebuffer_size_callback);
    glfwSetCursorPosCallback(window, mouse_callback);
    glfwSetScrollCallback(window, scroll_callback);
    glfwSetInputMode(window, GLFW_CURSOR, GLFW_CURSOR_DISABLED);

   

    GLuint vertS = glCreateShader(GL_VERTEX_SHADER);
    GLuint fragS = glCreateShader(GL_FRAGMENT_SHADER);
    
    glCompileShader(vertS);
    glCompileShader(fragS);

    GLint success;
    GLchar infoLog[512];
    glGetShaderiv(vertS, GL_COMPILE_STATUS, &success);
    if (!success) {
        glGetShaderInfoLog(vertS, 512, NULL, infoLog);
        std::cerr << "Vertex shader error:\n" << infoLog << std::endl;
    }
    glGetShaderiv(fragS, GL_COMPILE_STATUS, &success);
    if (!success) {
        glGetShaderInfoLog(fragS, 512, NULL, infoLog);
        std::cerr << "Fragment shader error:\n" << infoLog << std::endl;
    }

    GLuint program = glCreateProgram();
    glAttachShader(program, vertS);
    glAttachShader(program, fragS);
    glLinkProgram(program);
    glGetProgramiv(program, GL_LINK_STATUS, &success);
    if (!success) {
        glGetProgramInfoLog(program, 512, NULL, infoLog);
        std::cerr << "Linking error:\n" << infoLog << std::endl;
    }
    glDeleteShader(vertS);
    glDeleteShader(fragS);

    

    Shader shaderProgram("shader.vert", "shader.frag");

 
    GLint timeLoc = glGetUniformLocation(shaderProgram.ID, "time");
    GLint viewPosLoc = glGetUniformLocation(shaderProgram.ID, "viewPos");
    GLint lightPosLoc = glGetUniformLocation(shaderProgram.ID, "light.position");
    GLint lightAmbLoc = glGetUniformLocation(shaderProgram.ID, "light.ambient");
    GLint lightDiffLoc = glGetUniformLocation(shaderProgram.ID, "light.diffuse");
    GLint lightSpecLoc = glGetUniformLocation(shaderProgram.ID, "light.specular");
    GLint matAmbLoc = glGetUniformLocation(shaderProgram.ID, "material.ambient");
    GLint matDiffLoc = glGetUniformLocation(shaderProgram.ID, "material.diffuse");
    GLint matSpecLoc = glGetUniformLocation(shaderProgram.ID, "material.specular");
    GLint matShinLoc = glGetUniformLocation(shaderProgram.ID, "material.shininess");

 
    glm::vec3 lightPos(0.0f, 0.0f, 26.0f);
    glm::vec3 lightColor(1.0f, 1.0f, 1.0f);
   

    while (!glfwWindowShouldClose(window)) {
        float timeValue = static_cast<float>(glfwGetTime());  

        processInput(window);

        float currentFrame = static_cast<float>(glfwGetTime());
        deltaTime = currentFrame - lastFrame;
        lastFrame = currentFrame;

        glm::mat4 projection = glm::perspective(glm::radians(fov), (float)SCR_WIDTH / (float)SCR_HEIGHT, 0.1f, 100.0f);
        glm::mat4 view = glm::lookAt(cameraPos, cameraPos + cameraFront, cameraUp);
        glm::mat4 model = glm::mat4(1.0f);
        glm::mat4 transform = glm::mat4(1.0f);

        glm::mat3 normalMatrix = glm::transpose(glm::inverse(glm::mat3(model)));

        shaderProgram.Use();
        glUniform1f(timeLoc, timeValue);
        setMat4(shaderProgram.ID, "projection", projection);
        setMat4(shaderProgram.ID, "view", view);
        setMat4(shaderProgram.ID, "model", model);
        setMat4(shaderProgram.ID, "transform", transform);

        
        glUniformMatrix3fv(glGetUniformLocation(shaderProgram.ID, "normalMatrix"),1, GL_FALSE, glm::value_ptr(normalMatrix));

      
        glUniform3fv(viewPosLoc, 1, glm::value_ptr(cameraPos));
        glUniform3fv(lightPosLoc, 1, glm::value_ptr(lightPos));
        glUniform3fv(lightAmbLoc, 1, glm::value_ptr(glm::vec3(0.2f) * lightColor));
        glUniform3fv(lightDiffLoc, 1, glm::value_ptr(glm::vec3(0.5f) * lightColor));
        glUniform3fv(lightSpecLoc, 1, glm::value_ptr(glm::vec3(0.5f) * lightColor));

       
        glUniform3fv(matAmbLoc, 1, glm::value_ptr(glm::vec3(0.2f, 0.2f, 0.2f)));
        glUniform3fv(matDiffLoc, 1, glm::value_ptr(glm::vec3(0.8f, 0.8f, 0.8f)));
        glUniform3fv(matSpecLoc, 1, glm::value_ptr(glm::vec3(0.5f, 0.5f, 0.5f)));
        glUniform1f(matShinLoc, 32.0f);

        ourModel.Draw(lightShader, OX1_POS, OX2_POS, OX3_POS);

        glClearColor(0.1f, 0.2f, 0.1f, 1.0f);
        glClear(GL_COLOR_BUFFER_BIT);

        //glBindVertexArray(vao);
        //glDrawArrays(GL_TRIANGLE_FAN, 0, 10);

        ourRTC.Draw();   
        glfwSwapBuffers(window);
        glfwPollEvents();
    }

    glDeleteVertexArrays(1, &vao);
    glDeleteBuffers(1, &vbo);
    
    glfwTerminate();
    return 0;
}

void processInput(GLFWwindow* win) {
    const float cameraSpeed = 2.5f * deltaTime;
    if (glfwGetKey(win, GLFW_KEY_W) == GLFW_PRESS)
        cameraPos += cameraSpeed * cameraFront;
    if (glfwGetKey(win, GLFW_KEY_S) == GLFW_PRESS)
        cameraPos -= cameraSpeed * cameraFront;
    if (glfwGetKey(win, GLFW_KEY_A) == GLFW_PRESS)
        cameraPos -= glm::normalize(glm::cross(cameraFront, cameraUp)) * cameraSpeed;
    if (glfwGetKey(win, GLFW_KEY_D) == GLFW_PRESS)
        cameraPos += glm::normalize(glm::cross(cameraFront, cameraUp)) * cameraSpeed;

    if (glfwGetKey(win, GLFW_KEY_N) == GLFW_PRESS) {

        float NewAngle = OX1_Angle - deltaTime * 50;
        OX1_POS = glm::rotate(glm::mat4(1.0), glm::radians(NewAngle), glm::vec3(0, 1, 0));
        OX1_Angle = NewAngle;
    }
    
    if(glfwGetKey(win, GLFW_KEY_M) == GLFW_PRESS) {

        float NewAngle = OX1_Angle + deltaTime * 50;
        OX1_POS = glm::rotate(glm::mat4(1.0), glm::radians(NewAngle), glm::vec3(0, 1, 0));
        OX1_Angle = NewAngle;
    }

}

void mouse_callback(GLFWwindow* window, double xposIn, double yposIn) {
    float xpos = static_cast<float>(xposIn);
    float ypos = static_cast<float>(yposIn);

    if (firstMouse) {
        lastX = xpos;
        lastY = ypos;
        firstMouse = false;
    }

    float xoffset = xpos - lastX;
    float yoffset = lastY - ypos;
    lastX = xpos;
    lastY = ypos;

    float sensitivity = 0.05f;
    xoffset *= sensitivity;
    yoffset *= sensitivity;

    yaw += xoffset;
    pitch += yoffset;

    if (pitch > 89.0f)  pitch = 89.0f;
    if (pitch < -89.0f) pitch = -89.0f;

    glm::vec3 front;
    front.x = cos(glm::radians(yaw)) * cos(glm::radians(pitch));
    front.y = sin(glm::radians(pitch));
    front.z = sin(glm::radians(yaw)) * cos(glm::radians(pitch));
    cameraFront = glm::normalize(front);
}

void scroll_callback(GLFWwindow* window, double xoffset, double yoffset) {
    fov -= (float)yoffset;
    if (fov < 1.0f)  fov = 1.0f;
    if (fov > 45.0f) fov = 45.0f;
}

void framebuffer_size_callback(GLFWwindow* window, int width, int height) {
    glViewport(0, 0, width, height);
}


